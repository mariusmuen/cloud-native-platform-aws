# ---------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------
# Provider binaries and module cache (large, re-downloaded by `terraform init`)
**/.terraform/*

# State files contain resource IDs and often secrets in plain text.
# State lives exclusively in the S3 backend, never in the repository.
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Saved plans may contain sensitive values
*.tfplan
tfplan

# Variable files WITH secrets (regular terraform.tfvars without secrets are committed)
*.secret.tfvars
*.local.tfvars

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is committed on purpose (pins provider versions)

# ---------------------------------------------------------------
# Credentials & secrets – must NEVER be committed
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
credentials
.aws/
kubeconfig
*.kubeconfig

# ---------------------------------------------------------------
# Python (Lambda)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.zip
.pytest_cache/

# ---------------------------------------------------------------
# Helm
# ---------------------------------------------------------------
**/charts/*.tgz

# ---------------------------------------------------------------
# Editor & OS
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
